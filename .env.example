# このファイルをコピーして「.env」という名前で保存し、
# Workshop Studio の「AWS CLI credentials」に表示された内容を下に“そのまま”貼り付けてください。
# Mac 用（export ...）でも Windows 用（$Env:... / set ...）でも OK です。
#
# ⚠️ .env は GitHub に上げてはいけません（.gitignore で除外済み）
# ⚠️ 認証情報には有効期限があります。期限が切れたら貼り直してください。

export AWS_ACCESS_KEY_ID="ここに貼り付け"
export AWS_SECRET_ACCESS_KEY="ここに貼り付け"
export AWS_SESSION_TOKEN="ここに貼り付け"
export AWS_REGION="us-east-1"
