{
  "awsCredentialExport": "node scripts/aws-credentials.mjs",
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-east-1",
    "ANTHROPIC_MODEL": "us.anthropic.claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-5-5"
  },
  "permissions": {
    "allow": [
      "Bash(npm run bootstrap)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy:navara)",
      "Bash(npm run destroy)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./.env)",
      "Edit(./.env)"
    ]
  },
  "enabledPlugins": {
    "aws-core@anthropic-plugin-directory": true
  }
}
